# Admin UI configuration (Vite — only VITE_* vars are exposed to the browser).
# Copy to `.env` and fill in real values.

# Backend API base (FastAPI). Include the /api/v1 prefix.
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"

# Supabase project (used for admin login via supabase-js).
# The PUBLISHABLE key is safe to ship in a browser app; never put the secret key here.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
